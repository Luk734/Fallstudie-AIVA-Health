// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── EPIC-01: Core Platform ───────────────────────────────
// Tabelle: users
// Speichert alle Nutzerkonten. Passwort wird als bcrypt-Hash abgelegt,
// nie als Klartext!
//
// US-05: Profil-Felder ergänzt.
//   - firstName, lastName, birthDate, gender, avatarUrl
//   - Alle mit "?" → nullable, damit Register (nur Email+PW) weiter funktioniert
//   - Pflicht-Validierung (z.B. Vorname) passiert im Controller, nicht in der DB

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String    @map("password_hash")

  // ── Profil-Felder (US-05) ──────────────────────────────────
  firstName    String?   @map("first_name")   // Vorname (Pflicht im Controller)
  lastName     String?   @map("last_name")    // Nachname (optional)
  birthDate    DateTime? @map("birth_date")   // Geburtsdatum (für Vorsorge-Empfehlungen)
  gender       String?                         // "male" | "female" | "diverse" | "unspecified"
  avatarUrl    String?   @map("avatar_url")   // MVP: Platzhalter-Avatar

  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // ── Relation zu Consents (US-07) ───────────────────────────
  // Ein User kann mehrere Consent-Einträge haben (1:N).
  // Prisma braucht diese Zeile, um die Beziehung in beide Richtungen
  // navigierbar zu machen (z.B. user.consents in Queries).
  consents     Consent[]

  // ── Relation zu Appointments (US-13) ───────────────────────
  // Ein User kann beliebig viele Termine haben (1:N).
  appointments Appointment[]

  // ── Relation zu UserPrevention (US-17) ─────────────────────
  // Ein User kann mehrere Vorsorge-Einträge haben (1:N).
  // Jeder Eintrag verknüpft den User mit einer Vorsorge aus dem
  // GKV-Katalog und speichert seinen persönlichen Status.
  preventions  UserPrevention[]

  // ── Relation zu Notifications (US-18) ──────────────────────
  // Ein User kann beliebig viele Benachrichtigungen haben (1:N).
  // Wird für Termin-Erinnerungen und später auch für andere
  // Benachrichtigungstypen (Medikamente etc.) verwendet.
  notifications Notification[]

  // ── Relation zu Medications (US-19) ────────────────────────
  // Ein User kann mehrere Medikamente verwalten (1:N).
  // Jedes Medikament hat Dosierung, Einnahmezeiten und einen
  // aktiv/inaktiv-Status (Soft-Delete beim Absetzen).
  medications  Medication[]

  // ── Relation zu MedicationLogs (US-20) ─────────────────────
  // Ein User kann beliebig viele Einnahme-Protokoll-Einträge haben.
  // Jeder Eintrag dokumentiert ob ein Medikament zu einer bestimmten
  // Tageszeit eingenommen oder übersprungen wurde.
  medicationLogs MedicationLog[]

  // ── Relation zu LabReports (US-22) ─────────────────────────
  // Ein User kann mehrere Laborbefunde haben (1:N).
  // Jeder Befund enthält mehrere Messwerte (lab_values).
  labReports   LabReport[]

  @@map("users")
}

// ─── EPIC-01 / US-07: DSGVO-Einwilligungen ───────────────────
// Tabelle: consents
// Speichert jede einzelne Einwilligung separat mit Zeitstempel.
// Das ist DSGVO-konform: Wir können für jede Einwilligung nachweisen
// WANN sie erteilt (oder verweigert) wurde.
//
// consentType: Welche Art von Einwilligung?
//   "terms"       → Nutzungsbedingungen & Datenschutz (Pflicht)
//   "health_data" → Verarbeitung von Gesundheitsdaten (Pflicht)
//   "analytics"   → Anonymisierte Daten für Verbesserung (Optional)
//
// granted: true = eingewilligt, false = abgelehnt
// grantedAt: Zeitstempel der Einwilligung (DSGVO-Nachweispflicht)
//
// @@unique([userId, consentType]):
//   Ein User kann pro consentType nur EINEN Eintrag haben.
//   Dadurch wird verhindert, dass versehentlich doppelte Einträge entstehen.
//   Bei erneutem Speichern wird der bestehende Eintrag aktualisiert (upsert).

model Consent {
  id          Int      @id @default(autoincrement())

  // ── Fremdschlüssel zu User ─────────────────────────────────
  // userId verweist auf die id in der User-Tabelle.
  // onDelete: Cascade → wenn der User gelöscht wird, werden auch
  // seine Consents automatisch mitgelöscht.
  userId      Int      @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ── Consent-Daten ──────────────────────────────────────────
  consentType String   @map("consent_type")   // "terms" | "health_data" | "analytics"
  granted     Boolean  @default(false)         // true = eingewilligt
  grantedAt   DateTime @default(now()) @map("granted_at")  // Zeitstempel

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // ── Unique Constraint ──────────────────────────────────────
  // Pro User darf es nur EINEN Eintrag pro consentType geben.
  @@unique([userId, consentType])
  @@map("consents")
}

// ─── EPIC-02 / US-13: Arzttermine ────────────────────────────────────────
// Tabelle: appointments
// Speichert alle Termine eines Nutzers (Arztbesuche, Vorsorge etc.).
//
// status-Werte:
//   "scheduled"  → geplant, noch nicht stattgefunden
//   "completed"  → wahrgenommen / erledigt
//   "cancelled"  → abgesagt (Soft-Delete statt echtem Löschen → DSGVO-konform)
//
// datetime: Kombiniertes Datum+Uhrzeit des Termins.
//   → Im Frontend wird daraus z.B. "15. März 2026 · 10:30 Uhr" angezeigt.
//
// notes: Optionales Feld für eigene Notizen zum Termin.

model Appointment {
  id        Int      @id @default(autoincrement())

  // ── Fremdschlüssel zu User ─────────────────────────────────
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ── Termin-Daten ───────────────────────────────────────────
  title     String                              // z.B. "Zahnarzt-Kontrolle"
  doctor    String                              // Arztname, z.B. "Dr. Müller"
  phone     String?                             // Telefon der Praxis (US-14, optional)
  location  String                              // Praxis/Adresse
  datetime  DateTime                            // Datum + Uhrzeit des Termins
  notes     String?                             // Optionale Notizen
  status    String   @default("scheduled")      // "scheduled" | "completed" | "cancelled"

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("appointments")
}

// ─── EPIC-02 / US-15: Ärzte-Datenbank ────────────────────────────────────
// Tabelle: doctors
// Speichert eine Liste von Ärzten/Praxen, die beim Erstellen eines Termins
// als Vorauswahl angeboten werden ("Mock-Doctolib").
//
// Beim Termin-Anlegen wählt der User einen Arzt aus der Liste →
// Telefon + Ort werden automatisch ins Formular eingetragen.
// Der User kann die Daten aber auch manuell überschreiben.
//
// Im MVP sind die Ärzte vorbefüllt per Seed-Daten.
// Später könnte hier eine echte Doctolib-API angebunden werden.

model Doctor {
  id        Int      @id @default(autoincrement())
  name      String                              // "Dr. Sarah Müller"
  specialty String                              // "Hausärztin", "Zahnarzt", etc.
  phone     String?                             // "0711 / 123 456"
  location  String                              // "Praxis Müller, Königstr. 42, Stuttgart"
  createdAt DateTime @default(now()) @map("created_at")

  @@map("doctors")
}

// ─── EPIC-02 / US-17: Vorsorge-Katalog (GKV-Leistungen) ─────────────────
// Tabelle: prevention_schedules
// Statische Daten aus dem GKV-Leistungskatalog.
// Jede Zeile definiert EINE Vorsorge-Untersuchung mit:
//   - Altersbereich (ageFrom..ageTo)
//   - Geschlecht (null = alle, "male"/"female" = geschlechtsspezifisch)
//   - Häufigkeit in Monaten (12 = jährlich, 24 = alle 2 Jahre)
//
// Diese Daten ändern sich nicht zur Laufzeit — sie werden per Seed befüllt.
// Im MVP kein Live-API, sondern statische Abbildung des GKV-Katalogs.

model PreventionSchedule {
  id              Int      @id @default(autoincrement())
  type            String                        // Name: "Hautkrebs-Screening"
  description     String                        // Was wird gemacht?
  gender          String?                       // null = alle, "male", "female"
  ageFrom         Int      @map("age_from")     // Ab welchem Alter (inklusiv)
  ageTo           Int      @map("age_to")       // Bis welchem Alter (inklusiv)
  frequencyMonths Int      @map("frequency_months") // Intervall in Monaten
  createdAt       DateTime @default(now()) @map("created_at")

  // ── Relation: Welche User haben diese Vorsorge? ────────────
  userPreventions UserPrevention[]

  @@map("prevention_schedules")
}

// ─── EPIC-02 / US-17: User-Vorsorge-Status ──────────────────────────────
// Tabelle: user_preventions
// Verknüpft einen User mit einer Vorsorge aus dem GKV-Katalog.
// Speichert den persönlichen Status des Users für diese Vorsorge.
//
// status:
//   "open"      → Vorsorge steht noch aus, User hat sie noch nicht gemacht
//   "completed" → User hat die Vorsorge als erledigt markiert
//
// completedAt:
//   Zeitstempel, wann der User die Vorsorge als erledigt markiert hat.
//   null = noch offen.
//
// @@unique([userId, preventionId]):
//   Verhindert, dass ein User die gleiche Vorsorge doppelt hat.
//   Bei Status-Änderung wird der bestehende Eintrag aktualisiert.

model UserPrevention {
  id            Int       @id @default(autoincrement())

  // ── Fremdschlüssel zu User ─────────────────────────────────
  userId        Int       @map("user_id")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ── Fremdschlüssel zu PreventionSchedule ───────────────────
  preventionId  Int       @map("prevention_id")
  prevention    PreventionSchedule @relation(fields: [preventionId], references: [id], onDelete: Cascade)

  // ── Status-Daten ───────────────────────────────────────────
  status        String    @default("open")      // "open" | "completed"
  completedAt   DateTime? @map("completed_at")  // Wann erledigt? (null = offen)

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // ── Unique: Ein User hat pro Vorsorge genau EINEN Eintrag ──
  @@unique([userId, preventionId])
  @@map("user_preventions")
}

// ─── EPIC-02 / US-18: Benachrichtigungen (Termin-Erinnerungen) ───────────
// Tabelle: notifications
// Speichert In-App-Benachrichtigungen für den Nutzer.
//
// Im MVP werden hier automatisch generierte Termin-Erinnerungen gespeichert.
// Ein Cron-Job prüft regelmäßig, welche Termine bevorstehen und erstellt
// passende Notification-Einträge (1 Tag vorher, 1 Stunde vorher).
//
// type: Art der Benachrichtigung
//   "appointment_reminder" → Erinnerung an einen Arzttermin
//   (Später erweiterbar: "medication_reminder", "prevention_reminder" etc.)
//
// relatedId: Verweis auf das zugehörige Objekt (z.B. Appointment.id)
//   Damit können wir beim Klick auf die Benachrichtigung direkt
//   zum betreffenden Termin navigieren.
//   Nullable, weil nicht jede Benachrichtigung einen Bezug haben muss.
//
// read: Gelesen-Status
//   false = ungelesen (Standard) → wird im Badge-Zähler gezählt
//   true  = gelesen → wird nicht mehr im Badge gezählt

model Notification {
  id         Int      @id @default(autoincrement())

  // ── Fremdschlüssel zu User ─────────────────────────────────
  // Jede Benachrichtigung gehört zu genau einem User.
  // onDelete: Cascade → User gelöscht = Notifications weg.
  userId     Int      @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ── Benachrichtigungs-Daten ────────────────────────────────
  type       String                              // "appointment_reminder"
  title      String                              // Kurztitel: "Termin morgen"
  message    String                              // Detail: "Zahnarzt am 15.03. um 10:30"
  relatedId  Int?     @map("related_id")         // Optional: Appointment.id
  read       Boolean  @default(false)             // Gelesen? (Standard: nein)

  createdAt  DateTime @default(now()) @map("created_at")

  @@map("notifications")
}

// ─── EPIC-03 / US-19: Medikamenten-Liste ─────────────────────────────────
// Tabelle: medications
// Speichert die Medikamente eines Nutzers mit Dosierung und Einnahmezeiten.
//
// Thomas (56, Bluthochdruck) nimmt täglich Ramipril, Amlodipin und ASS.
// Jedes Medikament hat:
//   - Dosierung ("5mg")
//   - Einnahmezeiten als komma-separierter String ("morgens,abends")
//   - Farbcode für visuelle Erkennung auf der Karte
//   - active-Flag statt echtem Löschen (DSGVO: Daten nachvollziehbar)
//
// Warum times als String statt String[]?
//   Prisma's Array-Support hat Einschränkungen bei Filtern.
//   Ein komma-separierter String ("morgens,abends") ist im MVP
//   einfacher und wird im Frontend per split(',') zum Array.
//
// active-Flag (Soft-Delete):
//   false = Medikament wurde abgesetzt → wird nicht mehr in der aktiven
//   Liste angezeigt, bleibt aber in der DB für die Einnahme-Historie.
//   Das ist DSGVO-konform: Medizinische Daten dürfen nicht einfach
//   gelöscht werden, solange der Nutzer sie nicht explizit löschen lässt.

model Medication {
  id          Int       @id @default(autoincrement())

  // ── Fremdschlüssel zu User ─────────────────────────────────
  userId      Int       @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ── Medikamenten-Daten ─────────────────────────────────────
  name        String                              // "Ramipril"
  substance   String?                             // Wirkstoff-Gruppe: "ACE-Hemmer" (optional)
  dosage      String                              // "5mg"
  times       String                              // Komma-separiert: "morgens,abends"
  startDate   DateTime  @map("start_date")        // Ab wann eingenommen
  endDate     DateTime? @map("end_date")          // Bis wann (null = dauerhaft)
  color       String    @default("#4F46E5")       // Farbcode für visuelle Erkennung
  leafletUrl  String?   @map("leaflet_url")       // Link zum Beipackzettel (optional)
  active      Boolean   @default(true)             // true = aktiv, false = abgesetzt
  notes       String?                             // Optionale Notizen

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // ── Relation zu MedicationLogs (US-20) ─────────────────────
  // Einnahme-Protokoll: Jeder Log-Eintrag dokumentiert ob dieses
  // Medikament an einem bestimmten Tag/Zeit eingenommen wurde.
  logs        MedicationLog[]

  @@map("medications")
}

// ─── EPIC-03 / US-20: Einnahme-Protokoll ─────────────────────────────────
// Tabelle: medication_logs
// Protokolliert jede einzelne Medikamenten-Einnahme (oder Nicht-Einnahme).
//
// Thomas nimmt morgens Ramipril + ASS und abends Amlodipin.
// Für jeden Tag entstehen also 3 Einträge (1 pro Medikament+Zeit).
// Wenn er morgens auf ✅ klickt, wird der Eintrag auf "taken" gesetzt.
//
// scheduledDate: Das Datum, für das die Einnahme geplant ist (z.B. heute).
//   Wird als DateTime mit Uhrzeit 00:00:00 gespeichert (Date-only wäre besser,
//   aber Prisma/PostgreSQL verwenden DateTime für Kompatibilität).
//
// scheduledTime: Die Tageszeit ("morgens"/"mittags"/"abends"/"nachts").
//   Kommt aus dem times-Feld des Medikaments.
//
// status:
//   "pending"  → noch nicht eingenommen (Standard)
//   "taken"    → eingenommen (User hat ✅ geklickt)
//   "skipped"  → übersprungen (User hat ⏭️ geklickt)
//
// @@unique([medicationId, scheduledDate, scheduledTime]):
//   Pro Medikament+Tag+Zeit darf es nur EINEN Eintrag geben.
//   Das verhindert versehentliche Doppel-Einträge.

model MedicationLog {
  id             Int       @id @default(autoincrement())

  // ── Fremdschlüssel zu User ─────────────────────────────────
  userId         Int       @map("user_id")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ── Fremdschlüssel zu Medication ───────────────────────────
  medicationId   Int       @map("medication_id")
  medication     Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)

  // ── Log-Daten ──────────────────────────────────────────────
  scheduledDate  DateTime  @map("scheduled_date")   // Datum der geplanten Einnahme
  scheduledTime  String    @map("scheduled_time")   // "morgens" | "mittags" | "abends" | "nachts"
  status         String    @default("pending")       // "pending" | "taken" | "skipped"
  takenAt        DateTime? @map("taken_at")          // Zeitpunkt der Einnahme (null = noch offen)

  createdAt      DateTime  @default(now()) @map("created_at")

  // ── Unique: Pro Medikament+Tag+Zeit nur EIN Eintrag ────────
  @@unique([medicationId, scheduledDate, scheduledTime])
  @@map("medication_logs")
}

// ─── EPIC-03 / US-22: Laborbefunde ───────────────────────────────────────
// Tabelle: lab_reports
// Speichert Laborbefunde eines Nutzers (z.B. großes Blutbild, Leberwerte).
//
// Thomas (56, Bluthochdruck) bekommt regelmäßig Blutbilder.
// Jeder Befund hat:
//   - Titel (z.B. "Großes Blutbild")
//   - Labor und Arzt, der die Untersuchung angeordnet hat
//   - Datum des Befunds
//   - Mehrere Einzelwerte (1:N Relation zu lab_values)
//
// MVP: Mock-Daten per Seed, kein echtes ePA/FHIR-Interface.

model LabReport {
  id          Int       @id @default(autoincrement())

  // ── Fremdschlüssel zu User ─────────────────────────────────
  userId      Int       @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ── Befund-Daten ───────────────────────────────────────────
  title       String                              // "Großes Blutbild"
  labName     String    @map("lab_name")          // "Labor Stuttgart Mitte"
  doctorName  String    @map("doctor_name")       // "Dr. Sarah Müller"
  reportDate  DateTime  @map("report_date")       // Datum des Laborbefunds
  notes       String?                             // Optionale Anmerkungen

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // ── Relation zu LabValues (1:N) ────────────────────────────
  // Ein Befund enthält mehrere Messwerte (z.B. Hämoglobin, Leukozyten etc.)
  values      LabValue[]

  @@map("lab_reports")
}

// ─── EPIC-03 / US-22: Laborwerte (Einzelne Messwerte) ────────────────────
// Tabelle: lab_values
// Speichert die einzelnen Parameter eines Laborbefunds.
//
// Jeder Wert hat:
//   - parameter: Name des Laborwerts (z.B. "Hämoglobin")
//   - value: Gemessener Zahlenwert (z.B. 14.2)
//   - unit: Einheit (z.B. "g/dL")
//   - referenceMin / referenceMax: Normalbereich (für Ampel in US-23)
//
// Die Referenzbereiche werden mitgespeichert, weil sie je nach Labor
// leicht unterschiedlich sein können. So ist jeder Befund selbsterklärend.

model LabValue {
  id            Int       @id @default(autoincrement())

  // ── Fremdschlüssel zu LabReport ────────────────────────────
  reportId      Int       @map("report_id")
  report        LabReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  // ── Messwert-Daten ─────────────────────────────────────────
  parameter     String                              // "Hämoglobin"
  value         Float                               // 14.2
  unit          String                              // "g/dL"
  referenceMin  Float?    @map("reference_min")     // Unterer Normalwert (z.B. 12.0)
  referenceMax  Float?    @map("reference_max")     // Oberer Normalwert (z.B. 16.0)

  createdAt     DateTime  @default(now()) @map("created_at")

  @@map("lab_values")
}
